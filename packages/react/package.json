{
  "name": "plass-ui",
  "version": "1.3.0",
  "description": "A React UI component library made of glass and gradients — smooth tinted surfaces, shadows in their own colour, and light that follows the pointer. Accessible and themeable, ESM only, types included, dark mode built in.",
  "type": "module",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "author": "CDGet <jooy2.contact@gmail.com>",
  "license": "MIT",
  "homepage": "https://plass.cdget.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/jooy2/plass-ui",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/jooy2/plass-ui/issues"
  },
  "scripts": {
    "build": "npm run format:fix && npm run clean && tsc --project tsconfig.prod.json && node scripts/minify.mjs && node scripts/build-styles.mjs",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --report-unused-disable-directives --fix",
    "prepare": "npm run build",
    "size": "node scripts/size.mjs",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.prod.json --noEmit && tsc --project test/tsconfig.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "module": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "module": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./locales": {
      "types": "./dist/locales/index.d.ts",
      "module": "./dist/locales/index.js",
      "default": "./dist/locales/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "module": "./dist/provider/index.js",
      "default": "./dist/provider/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./tokens.css": "./dist/tokens.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "module": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "dist/types.d.ts"
      ],
      "hooks": [
        "dist/hooks/index.d.ts"
      ],
      "locales": [
        "dist/locales/index.d.ts"
      ],
      "provider": [
        "dist/provider/index.d.ts"
      ],
      "*": [
        "dist/components/*/index.d.ts"
      ]
    }
  },
  "keywords": [
    "plass-ui",
    "plass",
    "react",
    "reactjs",
    "react-components",
    "react-ui",
    "ui",
    "ui-kit",
    "ui-library",
    "ui-components",
    "component-library",
    "design-system",
    "design-language",
    "frontend",
    "web",
    "typescript",
    "tsx",
    "esm",
    "accessible",
    "accessibility",
    "a11y",
    "aria",
    "dark-mode",
    "theming",
    "glass",
    "glassmorphism",
    "liquid-glass",
    "plastic",
    "gradient",
    "button",
    "text-field",
    "form"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-react": "^2.2.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}
